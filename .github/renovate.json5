// Copyright The Muster Authors

{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices"],
  rangeStrategy: "pin",
  dependencyDashboard: true,
  // Dependency updates are committed as `build(deps): …`, which release-please lists under "Dependencies" instead of
  // "Bug Fixes". config:best-practices types every update `chore` and the runtime dependencies `fix` through package
  // rules, which a top-level semanticCommitType cannot override: the rules at the end of packageRules replace `fix`
  // with `build`, and the other updates stay `chore`, outside the changelog and without a release of their own.
  semanticCommits: "enabled",
  semanticCommitScope: "deps",
  // Version policy, as in Muster's repository: routine updates arrive once a week, grouped per ecosystem, and merge
  // themselves when every required check passes. Major updates wait in the Dependency Dashboard until a maintainer
  // ticks them. Security fixes are not held by the schedule.
  schedule: ["before 6am on Monday"],
  minimumReleaseAge: "3 days",
  prConcurrentLimit: 4,
  prHourlyLimit: 2,
  // A tool version pinned on the line under a `# renovate:` comment: `NAME_VERSION: 1.2.3` in a workflow's env, such
  // as the version of uv.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+_VERSION: (?<currentValue>\\S+)",
      ],
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      matchUpdateTypes: ["minor", "patch", "pin", "pinDigest", "digest"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      matchDatasources: ["github-actions"],
      groupName: "GitHub Actions",
    },
    {
      matchManagers: ["pep621"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Python packages (non-major)",
    },
    // The runtime dependencies keep the lower bounds the library states for its users; only uv.lock moves to the
    // newest releases, which CI tests.
    {
      matchManagers: ["pep621"],
      matchDepTypes: ["project.dependencies"],
      rangeStrategy: "update-lockfile",
    },
    // requires-python, the CI's Python matrix and the classifiers move by hand when CPython releases.
    {
      matchManagers: ["pep621"],
      matchDepTypes: ["requires-python"],
      enabled: false,
    },
    // .python-version names the newest CPython release of the matrix: Renovate proposes a new release and leaves the
    // pull request to the maintainer, who adds the release to the matrix and the classifiers in it.
    {
      matchManagers: ["pyenv"],
      automerge: false,
    },
    {
      matchPackageNames: ["datamodel-code-generator"],
      prBodyNotes: "Regenerate src/muster_bridge/models.py with `make generate` and commit it.",
    },
    {
      matchManagers: ["pep621"],
      matchDepTypes: ["project.dependencies", "project.optional-dependencies"],
      semanticCommitType: "build",
    },
    {
      matchJsonata: ["isLockfileUpdate = true"],
      semanticCommitType: "chore",
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on Monday"],
  },
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security"],
  },
}
